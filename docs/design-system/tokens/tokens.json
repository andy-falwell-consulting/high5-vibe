  "accent_policy": {
    "$note": "The red discipline. Modelled on how the source system treats its own accent, because the underlying problem is identical: a saturated red that fails text contrast at small sizes and gets reached for as a fill.",
    "policy": "Red is reserved for accents and key highlights. Quality over quantity.",
    "sanctioned": [
      "The High 5 logo mark",
      "The focus ring (--focus-ring)",
      "The active tab / nav indicator",
      "A destructive action's solid fill (--error-solid), where red carries meaning rather than decoration"
    ],
    "prohibited": [
      "Red backgrounds behind UI text, other than the sanctioned destructive fill",
      "The logo on any red surface",
      "Red as a category colour \u2014 it is the accent, and a category palette containing it cannot also signal 'this one matters'",
      "Red on text below 24px that is not a destructive label, where it fails WCAG AA"
    ]
  },
  "house_conventions": {
    "reason": "The High 5 style sheet publishes colour, logo rules and typefaces. It publishes NO gradations, spacing, radius, shadow, elevation, numeric type scale, line-height, letter-spacing, duration, easing or z-index. Everything listed here is a Vibe house convention, not a High 5 brand standard.",
    "scales": [
      "space",
      "radius",
      "shadow",
      "overlay",
      "font-family",
      "font-size",
      "font-weight",
      "line-height",
      "letter-spacing",
      "duration",
      "easing",
      "z-index"
    ],
    "derived": [
      "Every non-anchor step in palette.json \u2014 the style sheet gives seven flat colours and no ramps (see tokens/derive_palette.py).",
      "The grey hue, derived from the brand black so the neutral carries the same cast as the logo box.",
      "The green hue, for success. The brand has no green, and encoding success in one of the six brand hues would collide with category colour.",
      "All font fallback stacks."
    ],
    "non_palette_colors": {
      "rgba(0, 0, 0, 0.08 / 0.07 / 0.10 / 0.25)": "Shadow alphas. Neutral black at low alpha; no brand equivalent published.",
      "rgba(0, 0, 0, 0.45)": "Modal/slideout scrim (--scrim). House value."
    }
  }
